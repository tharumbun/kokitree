---
import Features2 from '~/components/widgets/Features2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'About kokitree',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="About kokitree"
    image={{
      src: 'https://images.unsplash.com/photo-1559136555-9303baea8ebd?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Caos Image',
    }}
  >
    <Fragment slot="title">
      Elevate your online presence with  <br />
      <span class="text-accent dark:text-white highlight"> kokitree</span>
    </Fragment>

    <Fragment slot="subtitle">
At kokitree, we love helping people like you build your brand story and cut through the noise—whether you're a startup, small business, professional, or marketer. In today’s digital world, standing out isn’t just about having a website or blog; it’s about creating meaningful connections through compelling content and smart web solutions. That’s where we come in.

</Fragment>
  </Hero>


  <!-- Steps2 Widget ****************** -->

  <Steps2
    title="Our values"
    subtitle="At kokitree, we are driven by a commitment to helping individuals and small businesses establish a strong digital presence. Our core values guide everything we do."
    items={[
      {
        title: 'Simplicity',
        description:
          'We believe in making website creation and domain selection easy and accessible for everyone.',
      },
      {
        title: 'Creativity',
        description:
          'We encourage unique brand storytelling and innovative web solutions that stand out.',
      },
      {
        title: 'Growth-Oriented',
        description:
          'We help businesses and individuals scale their digital footprint with long-term, sustainable strategies.',
      },
    ]}
  />

  <!-- Steps2 Widget ****************** -->

  <Steps2
    title="Our Work"
    subtitle="Crafting brands with care, Websites bloom, stories take flight, Digital roots grow."
    isReversed={true}
    callToAction={{
      text: 'See more',
      href: '/',
    }}
    items={[
      {
        title: 'Global reach',
        description: 'Nam malesuada urna in enim imperdiet tincidunt. Phasellus non tincidunt nisi, at elementum mi.',
        icon: 'tabler:globe',
      },
      {
        title: 'Positive customer feedback and reviews',
        description:
          'Cras semper nulla leo, eget laoreet erat cursus sed. Praesent faucibus massa in purus iaculis dictum.',
        icon: 'tabler:message-star',
      },
      {
        title: 'Awards and recognition as industry experts',
        description:
          'Phasellus lacinia cursus velit, eu malesuada magna pretium eu. Etiam aliquet tellus purus, blandit lobortis ex rhoncus vitae.',
        icon: 'tabler:award',
      },
    ]}
  />


  <Features2
    title="Technical Support"
    tagline="Contact us"
    columns={2}
    items={[
      {
        title: 'Chat with us',
        description:
          'Integer luctus laoreet libero, auctor varius purus rutrum sit amet. Ut nec molestie nisi, quis eleifend mi.',
        icon: 'tabler:messages',
      },
      {
        title: 'Call us',
        description:
          'Mauris faucibus finibus orci, in posuere elit viverra non. In hac habitasse platea dictumst. Cras lobortis metus a hendrerit congue.',
        icon: 'tabler:headset',
      },
    ]}
  />
</Layout>
