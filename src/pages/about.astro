---
import Features2 from '~/components/widgets/Features2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'About Kokitree',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="About Kokitree"
    image={{
      src: 'https://images.unsplash.com/photo-1559136555-9303baea8ebd?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Caos Image',
    }}
  >
    <Fragment slot="title">
      Kokitree is Cambodia’s hub for <br />
      <span class="text-accent dark:text-white highlight">one-of-a-kind digital products.</span>
    </Fragment>

    <Fragment slot="subtitle">

We’re building a vibrant online marketplace where creativity meets opportunity. Whether you're a designer, educator, writer, or entrepreneur, Kokitree is your place to share, sell, and discover unique digital creations—ranging from templates and ebooks to photos, learning resources, and more.

Our Mission
To empower creators across Cambodia and Southeast Asia by giving them the tools and platform to grow a digital business, reach global audiences, and thrive in the creator economy.

What Makes Us Different
🎨 Locally rooted, globally minded: We spotlight creators in Cambodia while welcoming a global community of buyers and sellers.

⚡ Simple and secure: Easy uploads, instant downloads, and smooth payments for everyone.

🌱 Community-driven: We’re not just a marketplace—we’re a growing network of creatives, freelancers, and makers who support one another.

For Creators
We make it easy to turn your digital work into income. Upload your products, set your price, and get paid—without the tech headaches.

For Buyers
Looking for something original? Browse our curated digital collections and find products made with heart and purpose.

Join us and be part of Cambodia’s creative digital movement.
Explore Kokitree, where creators grow and digital ideas come to life.
</Fragment>
  </Hero>


  <!-- Steps2 Widget ****************** -->

  <Steps2
    title="Our values"
    subtitle="At Kokitree, our values shape everything we do—from the products we host to the community we build."
    items={[
      {
        title: 'Local Roots, Global Reach',
        description:
          'We’re proud to start in Cambodia—with a vision to connect local talent to global opportunities.',
      },
      {
        title: 'Community',
        description:
          'We’re stronger together. Kokitree is a supportive space for creators and buyers to connect, collaborate, and lift each other up.',
      },
      {
        title: 'Empowerment',
        description:
          'We believe in giving creators the tools and opportunities to grow, earn, and thrive in the digital economy.',
      },
    ]}
  />


</Layout>
