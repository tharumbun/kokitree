---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Kokitree — Cambodia’s hub for one-of-a-kind digital products',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Learn more',
        href: '#features',
        icon: 'tabler:download',
      },

    ]}
    image={{ src: '~/assets/images/hero-image.png', alt: 'AstroWind Hero Image' }}
  >
    <Fragment slot="title">
Cambodia’s hub
      <span class="text-accent dark:text-white highlight"> for </span> one-of-a-kind digital products
    </Fragment>

    <Fragment slot="subtitle">
    <span class="font-semibold">a friendly marketplace</span> where local creators<span class="block mb-1 am:hidden font-bold text-blue-600">sell </span> cool 
</span>digital stuff
    </Fragment>
  </Hero>

  <!-- Note Widget ******************* -->

  <Note title="Community-driven:" a supportive space for creators and buyers to connect, collaborate, and lift each other up." />


  <!-- Features2 Widget ************** -->

  <Features2
    title="Most used widgets"
    subtitle="Provides frequently used components for building websites using Tailwind CSS"
    tagline="Components"
    items={[
      {
        title: 'For Creators',
        description: "We make it easy to turn your digital work into income. Upload your products, set your price, and get paid—without the tech headaches.',
      },
      {
        title: 'For Buyers',
        description:
          "Looking for something original? Browse our curated digital collections and find products made with heart and purpose.",
        icon: 'flat-color-icons:gallery',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>



  <!-- Features Widget *************** -->
  <Features
    id="features"
    tagline="Browse Products"
    title="Shop Unique Creations"
    subtitle="Dive into our curated collection of unique digital products created by talented Cambodian and regional artists"
    items={[
      {
        title: 'Website & Blog',
        description:
          'A ready-to-go niche content website and blog with high-quality articles, clean design, and SEO-friendly structure. Ideal for entrepreneurs, bloggers, or affiliate marketers looking for a solid starting point to grow traffic and revenue.',
        icon: 'tabler:brand-tailwind',
      },
      {
        title: 'Brandable Domain Names',
        description:
          'Unique, memorable domain names designed to stand out. Perfect for startups, creators, and digital businesses looking to build a strong, recognizable online identity.',
        icon: 'tabler:components',
      },
      {
        title: 'E-Books',
        description:
          'Instantly downloadable digital books covering a range of topics—from how-to guides and personal growth to business insights and creative storytelling.',
        icon: 'tabler:list-check',
      },
      {
        title: 'Photographs',
        description:
          'A curated collection of high-quality digital images capturing unique moments, places, and perspectives—perfect for creative projects, websites, and storytelling.',
        icon: 'tabler:rocket',
      },
    ]}
  />

  <!-- HighlightedPosts Widget ******* -->





  <BlogLatestPosts
    title="Delve deeper"
    information={`With our in-depth reviews and how-tos, you’ll gain the knowledge and skills needed to grow.`}
  />


</Layout>
