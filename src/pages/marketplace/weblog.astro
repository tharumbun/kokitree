---
import Layout from '~/layouts/PageLayout.astro';

import Header from '~/components/widgets/Header.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Features from '~/components/widgets/Features.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Content from '~/components/widgets/Content.astro';
import Pricing from '~/components/widgets/Pricing.astro';

import { headerData } from '~/navigation';
import FAQs from '~/components/widgets/FAQs.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';

const metadata = {
  title: 'Brandable Domain Names',
};
---

<Layout metadata={metadata}>
  <Fragment slot="header">
    <Header
      {...headerData}

    />
  </Fragment>

  <!-- Hero2 Widget ******************* -->

  <Hero2
    tagline="Launch your digital journey with a website that’s ready to grow."

    image={{
      src: 'https://images.unsplash.com/photo-1580481072645-022f9a6dbf27?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'AstroWind Hero Image',
    }}
  >
    <Fragment slot="title">
     Websites & blogs
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        Discover ready-made websites and blogs crafted for <span class="font-semibold">creators, entrepreneurs, and niche enthusiasts.</span>  Whether you're looking to jumpstart a personal blog,</span
      >launch a content business, or invest in a unique digital asset, our curated selection offers high-quality, brandable sites built for growth and storytelling.


<h2>Available on sale:</h2>
<h3>cambodiano.com</h3>


    </Fragment>
  </Hero2>


  <!-- BlogLatestPost Widget **************** -->

  <BlogLatestPosts
    id="blog"
    title="Stay informed with our blog"
    information={`Explore our collection of articles, guides, and tutorials on web development, and design trends.`}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </BlogLatestPosts>
</Layout>
