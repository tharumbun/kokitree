---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Contact',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

<HeroText tagline="Contact" title="hello@kokitree.com" />


  <div class="my-8 text-lg">
    <p>Get in Touch with Kokitree</p>
    <p>
      We’d love to hear from you! Whether you have a question about our digital products, need help
      choosing a domain name, or want to collaborate, our team is here to help.
    </p>
  </div>


</Layout>
